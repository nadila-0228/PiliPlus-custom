diff --git a/lib/common/widgets/scroll_behavior.dart b/lib/common/widgets/scroll_behavior.dart
index e2d55ff07102fdbf65698e50e6b0157c867d28f4..9d089b02d25c8ef9e7e896af2b225cbd769c5054 100644
--- a/lib/common/widgets/scroll_behavior.dart
+++ b/lib/common/widgets/scroll_behavior.dart
@@ -1,5 +1,7 @@
 import 'dart:io' show Platform;
 
+import 'package:PiliPlus/common/widgets/scroll_physics.dart'
+    show HarmonyBouncingScrollPhysics;
 import 'package:flutter/gestures.dart' show PointerDeviceKind;
 import 'package:material_ui/material_ui.dart';
 import 'package:os_type/os_type.dart';
@@ -56,8 +58,8 @@ class NoOverscrollIndicator extends CustomScrollBehavior {
 
 /// 鸿蒙上对齐 Flutter 在 iOS 上的滚动物理
 /// 补充：保证 Flutter 上列表滚动物理和鸿蒙原生界面滚动物理保持一致
-/// 与 scroll_configuration.dart 中 iOS 的 _bouncingPhysics 完全一致，
-/// 即 BouncingScrollPhysics + RangeMaintainingScrollPhysics。
+/// 使用 BouncingScrollPhysics + RangeMaintainingScrollPhysics，
+/// 可选降低开始拖动时的额外位移过滤。
 /// 过滚动指示沿用 [CustomScrollBehavior]：ohos 上非 Platform.isAndroid，
 /// 走 return child，无拉伸/发光，与 iOS 一致
 class HarmonyScrollBehavior extends CustomScrollBehavior {
@@ -66,7 +68,7 @@ class HarmonyScrollBehavior extends CustomScrollBehavior {
   @override
   ScrollPhysics getScrollPhysics(BuildContext context) {
     if (OS.isHarmony) {
-      return const BouncingScrollPhysics(
+      return const HarmonyBouncingScrollPhysics(
         parent: RangeMaintainingScrollPhysics(),
       );
     }
diff --git a/lib/common/widgets/scroll_physics.dart b/lib/common/widgets/scroll_physics.dart
index 890b8f4a396b93c82fb6ce8c4fa9d8c0bd293385..9cce70fd740693eb4202dbdd468ff0f51ce548ac 100644
--- a/lib/common/widgets/scroll_physics.dart
+++ b/lib/common/widgets/scroll_physics.dart
@@ -99,7 +99,25 @@ final platformAlwaysClampingPhysics = PlatformUtils.isDarwin || OS.isHarmony
     ? const AlwaysScrollableScrollPhysics(parent: BouncingScrollPhysicsExt())
     : const AlwaysScrollableScrollPhysics(parent: ClampingScrollPhysics());
 
-class BouncingScrollPhysicsExt extends BouncingScrollPhysics
+// Read once at startup; the settings switch updates this for the next drag.
+// Keep gesture recognition thresholds unchanged so page/list direction selection
+// still uses the upstream rules. This only reduces the extra motion dead zone.
+bool quickScrollStart = OS.isHarmony && Pref.quickScrollStart;
+
+class HarmonyBouncingScrollPhysics extends BouncingScrollPhysics {
+  const HarmonyBouncingScrollPhysics({super.parent});
+
+  @override
+  HarmonyBouncingScrollPhysics applyTo(ScrollPhysics? ancestor) {
+    return HarmonyBouncingScrollPhysics(parent: buildParent(ancestor));
+  }
+
+  @override
+  double get dragStartDistanceMotionThreshold =>
+      quickScrollStart ? 1.0 : super.dragStartDistanceMotionThreshold;
+}
+
+class BouncingScrollPhysicsExt extends HarmonyBouncingScrollPhysics
     with ClampingBoundaryMixin {
   const BouncingScrollPhysicsExt({super.parent});
 
