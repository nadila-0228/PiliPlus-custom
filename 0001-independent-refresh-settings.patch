+import 'package:PiliPlus/models/common/refresh_settings.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  test('a missing new setting preserves the old actual refresh threshold', () {
+    for (final height in <double>[10, 20, 40, 100]) {
+      final settings = RefreshSettings.fromStored(
+        height,
+        null,
+        defaultDisplacement: 20,
+      );
+      expect(settings.displacement, height);
+      // Old opacity reached 1 at 2/3 of the displayed (height + 49) * 1.5.
+      expect(settings.triggerDistance, height + 49);
+    }
+  });
+
+  test('first-run defaults follow the platform height', () {
+    final mobile = RefreshSettings.fromStored(
+      null,
+      null,
+      defaultDisplacement: 20,
+    );
+    final desktop = RefreshSettings.fromStored(
+      null,
+      null,
+      defaultDisplacement: 40,
+    );
+    expect(mobile.displacement, 20);
+    expect(mobile.triggerDistance, 69);
+    expect(desktop.displacement, 40);
+    expect(desktop.triggerDistance, 89);
+  });
+
+  test('stored integer and fractional values remain independent', () {
+    final settings = RefreshSettings.fromStored(
+      300,
+      12.5,
+      defaultDisplacement: 20,
+    );
+    expect(settings.displacement, 300.0);
+    expect(settings.triggerDistance, 12.5);
+  });
+
+  test('bad stored heights recover without replacing a valid distance', () {
+    for (final invalid in <Object?>[
+      null,
+      '20',
+      double.nan,
+      double.infinity,
+      -1,
+      1000.1,
+    ]) {
+      final settings = RefreshSettings.fromStored(
+        invalid,
+        250,
+        defaultDisplacement: 20,
+      );
+      expect(settings.displacement, 20, reason: 'stored height: $invalid');
+      expect(settings.triggerDistance, 250, reason: 'stored height: $invalid');
+    }
+  });
+
+  test('bad stored distances recover to the actual legacy threshold', () {
+    for (final invalid in <Object?>[
+      null,
+      '100',
+      double.nan,
+      double.infinity,
+      0,
+      -1,
+      5000.1,
+    ]) {
+      final settings = RefreshSettings.fromStored(
+        70,
+        invalid,
+        defaultDisplacement: 20,
+      );
+      expect(settings.displacement, 70, reason: 'stored distance: $invalid');
+      expect(
+        settings.triggerDistance,
+        119,
+        reason: 'stored distance: $invalid',
+      );
+    }
+  });
+
+  test('zero height and both upper boundaries survive storage reload', () {
+    final minimum = RefreshSettings.fromStored(0, 1, defaultDisplacement: 20);
+    final maximum = RefreshSettings.fromStored(
+      1000,
+      5000,
+      defaultDisplacement: 20,
+    );
+    expect(minimum.displacement, 0);
+    expect(minimum.triggerDistance, 1);
+    expect(maximum.displacement, 1000);
+    expect(maximum.triggerDistance, 5000);
+  });
+}
