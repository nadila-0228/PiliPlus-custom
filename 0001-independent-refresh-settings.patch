diff --git a/test/custom_patch/refresh_indicator_test.dart b/test/custom_patch/refresh_indicator_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..d07995470176a5087d01c90802ee401691e7f10d
--- /dev/null
+++ b/test/custom_patch/refresh_indicator_test.dart
@@ -0,0 +1,269 @@
+import 'dart:async';
+import 'dart:io';
+
+import 'package:PiliPlus/common/widgets/flutter/refresh_indicator.dart'
+    as custom;
+import 'package:PiliPlus/utils/storage.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:hive_ce/hive.dart';
+
+// Inject scroll notifications so these tests measure the component's actual
+// threshold independently of a platform's touch slop and scroll resistance.
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  late Directory storageDirectory;
+
+  setUpAll(() async {
+    storageDirectory = await Directory.systemTemp.createTemp(
+      'piliplus_refresh_test_',
+    );
+    Hive.init(storageDirectory.path);
+    GStorage.setting = await Hive.openBox<dynamic>('setting');
+  });
+
+  tearDownAll(() async {
+    await GStorage.setting.close();
+    await storageDirectory.delete(recursive: true);
+  });
+
+  setUp(() {
+    custom.displacement = 20;
+    custom.refreshTriggerDistance = 100;
+  });
+
+  for (final height in <double>[0, 20, 300]) {
+    testWidgets('height $height does not change the refresh threshold', (
+      tester,
+    ) async {
+      custom.displacement = height;
+      final fixture = await _Fixture.mount(tester);
+
+      await fixture.start(tester);
+      await fixture.pull(tester, 99.5);
+      await fixture.release(tester);
+      expect(fixture.refreshCount, 0);
+
+      await fixture.start(tester);
+      await fixture.pull(tester, 100);
+      await fixture.release(tester);
+      expect(fixture.refreshCount, 1);
+    });
+  }
+
+  for (final distance in <double>[1, 60.5, 250]) {
+    testWidgets('distance $distance changes the threshold but not height', (
+      tester,
+    ) async {
+      custom.displacement = 35;
+      custom.refreshTriggerDistance = distance;
+      final fixture = await _Fixture.mount(tester, edgeOffset: 72);
+
+      await fixture.start(tester);
+      await fixture.pull(tester, distance - 0.25);
+      await fixture.release(tester);
+      expect(fixture.refreshCount, 0);
+
+      await fixture.start(tester);
+      await fixture.pull(tester, distance);
+      await fixture.release(tester);
+      expect(fixture.refreshCount, 1);
+      expect(fixture.indicatorTop(tester), closeTo(72 + 35, 0.001));
+    });
+  }
+
+  testWidgets('pulling back below the threshold cancels refresh', (
+    tester,
+  ) async {
+    final fixture = await _Fixture.mount(tester);
+    await fixture.start(tester);
+    await fixture.pull(tester, 120);
+    fixture.dispatch(
+      ScrollUpdateNotification(
+        metrics: _metrics,
+        context: fixture.context,
+        scrollDelta: 30,
+        dragDetails: DragUpdateDetails(
+          delta: const Offset(0, -30),
+          globalPosition: Offset.zero,
+        ),
+      ),
+    );
+    await tester.pump();
+    await fixture.release(tester);
+    expect(fixture.refreshCount, 0);
+  });
+
+  testWidgets('a transparent indicator does not refresh below the threshold', (
+    tester,
+  ) async {
+    final fixture = await _Fixture.mount(tester, color: Colors.transparent);
+    await fixture.start(tester);
+    await fixture.pull(tester, 10);
+    await fixture.release(tester);
+    expect(fixture.refreshCount, 0);
+
+    await fixture.start(tester);
+    await fixture.pull(tester, 100);
+    await fixture.release(tester);
+    expect(fixture.refreshCount, 1);
+  });
+
+  testWidgets('bounce-back notifications use the same explicit threshold', (
+    tester,
+  ) async {
+    final fixture = await _Fixture.mount(tester, color: Colors.transparent);
+    await fixture.start(tester);
+    await fixture.pull(tester, 99);
+    await fixture.bounce(tester);
+    expect(fixture.refreshCount, 0);
+
+    await fixture.pull(tester, 1);
+    await fixture.bounce(tester);
+    expect(fixture.refreshCount, 1);
+  });
+
+  testWidgets('changing height relayouts an already refreshing indicator', (
+    tester,
+  ) async {
+    final fixture = await _Fixture.mount(tester, edgeOffset: 64);
+    await fixture.start(tester);
+    await fixture.pull(tester, 100);
+    await fixture.release(tester);
+    expect(fixture.indicatorTop(tester), closeTo(64 + 20, 0.001));
+
+    custom.displacement = 125.5;
+    // The settings page marks existing indicator elements for rebuild.
+    (fixture.indicatorKey.currentContext! as Element).markNeedsBuild();
+    await tester.pump();
+
+    expect(fixture.indicatorTop(tester), closeTo(64 + 125.5, 0.001));
+    expect(custom.refreshTriggerDistance, 100);
+    expect(fixture.refreshCount, 1);
+  });
+
+  testWidgets('programmatic show remains independent of the drag distance', (
+    tester,
+  ) async {
+    custom.displacement = 48;
+    custom.refreshTriggerDistance = 5000;
+    final fixture = await _Fixture.mount(tester, edgeOffset: 32);
+    final refresh = fixture.indicatorKey.currentState!.show();
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 200));
+
+    expect(fixture.refreshCount, 1);
+    expect(fixture.indicatorTop(tester), closeTo(32 + 48, 0.001));
+    fixture.done.complete();
+    await tester.pump();
+    await refresh;
+    await tester.pumpAndSettle();
+  });
+}
+
+final _metrics = FixedScrollMetrics(
+  minScrollExtent: 0,
+  maxScrollExtent: 1000,
+  pixels: 0,
+  viewportDimension: 600,
+  axisDirection: AxisDirection.down,
+  devicePixelRatio: 1,
+);
+
+class _Fixture {
+  final indicatorKey = GlobalKey<custom.RefreshIndicatorState>();
+  final bodyKey = GlobalKey();
+  final done = Completer<void>();
+  int refreshCount = 0;
+
+  BuildContext get context => bodyKey.currentContext!;
+
+  static Future<_Fixture> mount(
+    WidgetTester tester, {
+    double edgeOffset = 0,
+    Color? color,
+  }) async {
+    final fixture = _Fixture();
+    addTearDown(() async {
+      if (!fixture.done.isCompleted) fixture.done.complete();
+      await tester.pump();
+      await tester.pumpWidget(const SizedBox.shrink());
+    });
+    await tester.pumpWidget(
+      MaterialApp(
+        home: custom.RefreshIndicator(
+          key: fixture.indicatorKey,
+          edgeOffset: edgeOffset,
+          color: color,
+          onRefresh: () {
+            fixture.refreshCount++;
+            return fixture.done.future;
+          },
+          child: Builder(
+            key: fixture.bodyKey,
+            builder: (_) => const SizedBox.expand(),
+          ),
+        ),
+      ),
+    );
+    return fixture;
+  }
+
+  void dispatch(ScrollNotification notification) {
+    notification.dispatch(context);
+  }
+
+  Future<void> start(WidgetTester tester) async {
+    dispatch(
+      ScrollStartNotification(
+        metrics: _metrics,
+        context: context,
+        dragDetails: DragStartDetails(),
+      ),
+    );
+    await tester.pump();
+  }
+
+  Future<void> pull(WidgetTester tester, double distance) async {
+    dispatch(
+      OverscrollNotification(
+        metrics: _metrics,
+        context: context,
+        overscroll: -distance,
+        dragDetails: DragUpdateDetails(
+          delta: Offset(0, distance),
+          globalPosition: Offset.zero,
+        ),
+      ),
+    );
+    await tester.pump();
+  }
+
+  Future<void> release(WidgetTester tester) async {
+    dispatch(ScrollEndNotification(metrics: _metrics, context: context));
+    await tester.pump();
+    // _dismiss first yields a microtask before starting its animation.
+    await tester.pump();
+    // Both a canceled pull and a snap animation finish within 200 ms.
+    await tester.pump(const Duration(milliseconds: 250));
+    await tester.pump();
+  }
+
+  Future<void> bounce(WidgetTester tester) async {
+    dispatch(
+      ScrollUpdateNotification(
+        metrics: _metrics,
+        context: context,
+        scrollDelta: 0,
+      ),
+    );
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 200));
+    await tester.pump();
+  }
+
+  double indicatorTop(WidgetTester tester) {
+    return tester.getTopLeft(find.byType(RefreshProgressIndicator)).dy -
+        tester.getTopLeft(find.byKey(bodyKey)).dy;
+  }
+}
diff --git a/test/custom_patch/refresh_settings_dialog_test.dart b/test/custom_patch/refresh_settings_dialog_test.dart
