@@ -0,0 +1,42 @@
+/// Independent indicator position and refresh threshold, in logical pixels.
+class RefreshSettings {
+  const RefreshSettings({
+    required this.displacement,
+    required this.triggerDistance,
+  });
+
+  static const indicatorSize = 49.0;
+  static const dragSizeFactorLimit = 1.5;
+  static const maxDisplacement = 1000.0;
+  static const minDragDistance = 1.0;
+  static const maxDragDistance = 5000.0;
+
+  final double displacement;
+  final double triggerDistance;
+
+  static bool isValidDisplacement(num? value) =>
+      value != null && value.isFinite && value >= 0 && value <= maxDisplacement;
+
+  static bool isValidTriggerDistance(num? value) =>
+      value != null &&
+      value.isFinite &&
+      value >= minDragDistance &&
+      value <= maxDragDistance;
+
+  factory RefreshSettings.fromStored(
+    Object? displacement,
+    Object? triggerDistance, {
+    required double defaultDisplacement,
+  }) {
+    final height = displacement is num && isValidDisplacement(displacement)
+        ? displacement.toDouble()
+        : defaultDisplacement;
+    // Previously alpha reached 1 at 2/3 of the displayed drag extent.
+    // Preserve the actual old threshold, not that displayed extent.
+    final distance =
+        triggerDistance is num && isValidTriggerDistance(triggerDistance)
+        ? triggerDistance.toDouble()
+        : height + indicatorSize;
+    return RefreshSettings(displacement: height, triggerDistance: distance);
+  }
+}
