+import 'package:PiliPlus/models/common/refresh_settings.dart';
+import 'package:PiliPlus/pages/setting/widgets/refresh_settings_dialog.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  testWidgets('saving only height keeps the migrated distance independent', (
+    tester,
+  ) async {
+    final fixture = await _DialogFixture.open(tester);
+    await tester.enterText(fixture.heightField, '250.25');
+    await fixture.save(tester);
+
+    expect(fixture.resolved, isTrue);
+    expect(fixture.result!.displacement, 250.25);
+    expect(fixture.result!.triggerDistance, 69);
+  });
+
+  testWidgets('both decimal values can be entered and saved', (tester) async {
+    final fixture = await _DialogFixture.open(tester);
+    await tester.enterText(fixture.heightField, '12.5');
+    await tester.enterText(fixture.distanceField, '420.25');
+    await fixture.save(tester);
+
+    expect(fixture.result!.displacement, 12.5);
+    expect(fixture.result!.triggerDistance, 420.25);
+  });
+
+  testWidgets('cancel discards edited values', (tester) async {
+    final fixture = await _DialogFixture.open(tester);
+    await tester.enterText(fixture.heightField, '120');
+    await tester.enterText(fixture.distanceField, '300');
+    await tester.tap(find.text('取消'));
+    await tester.pumpAndSettle();
+
+    expect(fixture.resolved, isTrue);
+    expect(fixture.result, isNull);
+  });
+
+  testWidgets(
+    'restore defaults requires confirmation and uses platform height',
+    (tester) async {
+      final fixture = await _DialogFixture.open(
+        tester,
+        value: const RefreshSettings(displacement: 180, triggerDistance: 400),
+        defaultDisplacement: 40,
+      );
+      await tester.tap(find.text('恢复默认'));
+      await tester.pump();
+
+      expect(fixture.resolved, isFalse);
+      expect(
+        tester.widget<TextFormField>(fixture.heightField).controller!.text,
+        '40.0',
+      );
+      expect(
+        tester.widget<TextFormField>(fixture.distanceField).controller!.text,
+        '89.0',
+      );
+      await fixture.save(tester);
+      expect(fixture.result!.displacement, 40);
+      expect(fixture.result!.triggerDistance, 89);
+    },
+  );
+
+  testWidgets('invalid heights stay in the dialog and can be corrected', (
+    tester,
+  ) async {
+    final fixture = await _DialogFixture.open(tester);
+    for (final invalid in ['', 'NaN', 'Infinity', '-1', '1000.1']) {
+      await tester.enterText(fixture.heightField, invalid);
+      await fixture.save(tester);
+      expect(fixture.resolved, isFalse, reason: 'height: $invalid');
+      expect(find.text('请输入 0～1000 之间的有效数字'), findsOneWidget);
+    }
+
+    await tester.enterText(fixture.heightField, '0');
+    await fixture.save(tester);
+    expect(fixture.result!.displacement, 0);
+    expect(fixture.result!.triggerDistance, 69);
+  });
+
+  testWidgets('invalid distances stay in the dialog and can be corrected', (
+    tester,
+  ) async {
+    final fixture = await _DialogFixture.open(tester);
+    for (final invalid in ['0', '5000.1', 'NaN', 'Infinity', 'abc']) {
+      await tester.enterText(fixture.distanceField, invalid);
+      await fixture.save(tester);
+      expect(fixture.resolved, isFalse, reason: 'distance: $invalid');
+      expect(find.text('请输入 1～5000 之间的有效数字'), findsOneWidget);
+    }
+
+    await tester.enterText(fixture.distanceField, '1');
+    await fixture.save(tester);
+    expect(fixture.result!.displacement, 20);
+    expect(fixture.result!.triggerDistance, 1);
+  });
+
+  testWidgets('upper boundaries are accepted', (tester) async {
+    final fixture = await _DialogFixture.open(tester);
+    await tester.enterText(fixture.heightField, '1000');
+    await tester.enterText(fixture.distanceField, '5000');
+    await fixture.save(tester);
+    expect(fixture.result!.displacement, 1000);
+    expect(fixture.result!.triggerDistance, 5000);
+  });
+}
+
+class _DialogFixture {
+  RefreshSettings? result;
+  bool resolved = false;
+
+  Finder get heightField => find.byType(TextFormField).at(0);
+  Finder get distanceField => find.byType(TextFormField).at(1);
+
+  static Future<_DialogFixture> open(
+    WidgetTester tester, {
+    RefreshSettings value = const RefreshSettings(
+      displacement: 20,
+      triggerDistance: 69,
+    ),
+    double defaultDisplacement = 20,
+  }) async {
+    final fixture = _DialogFixture();
+    await tester.pumpWidget(
+      MaterialApp(
+        home: Scaffold(
+          body: Builder(
+            builder: (context) => TextButton(
+              onPressed: () async {
+                fixture.result = await showDialog<RefreshSettings>(
+                  context: context,
+                  builder: (_) => RefreshSettingsDialog(
+                    value: value,
+                    defaultDisplacement: defaultDisplacement,
+                  ),
+                );
+                fixture.resolved = true;
+              },
+              child: const Text('打开设置'),
+            ),
+          ),
+        ),
+      ),
+    );
+    await tester.tap(find.text('打开设置'));
+    await tester.pumpAndSettle();
+    return fixture;
+  }
+
+  Future<void> save(WidgetTester tester) async {
+    await tester.tap(find.text('确定'));
+    await tester.pumpAndSettle();
+  }
+}
